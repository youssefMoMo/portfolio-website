# ═══════════════════════════════════════════════════════════════
# .env.example — copy to .env.local for development
# On Vercel: add these under Project → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════

# Supabase — public (safe to expose in browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Dev-only fallback login (used when Supabase is not configured)
# loginDev() reads these — never hardcode values
VITE_DEV_ADMIN_ID=your_discord_id
VITE_DEV_ADMIN_PASSWORD=a_strong_local_password
